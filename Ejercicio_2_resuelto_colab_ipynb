        "CARACTERES_POR_TOKEN = 4  # aproximación habitual para texto en inglés\n",
        "\n",
        "\n",
        "def estimar_tokens(texto):\n",
        "    \"\"\"Estimación rápida del nº de tokens de un texto.\"\"\"\n",
        "    return int(len(texto) / CARACTERES_POR_TOKEN) + 1\n",
        "\n",
        "\n",
        "def recortar_inicio_fin(texto, max_caracteres, caracteres_final):\n",
        "    \"\"\"Acorta un texto largo conservando su inicio y su final.\"\"\"\n",
        "    if len(texto) <= max_caracteres:\n",
        "        return texto\n",
        "    inicio = texto[:max_caracteres - caracteres_final]\n",
        "    final = texto[-caracteres_final:]\n",
        "    return f'{inicio} [...] {final}'\n",
        "\n",
        "\n",
        "def hacer_lotes(elementos, tam_lote):\n",
        "    \"\"\"Divide una lista en trozos de tam_lote elementos.\"\"\"\n",
        "    return [elementos[inicio:inicio + tam_lote]\n",
        "            for inicio in range(0, len(elementos), tam_lote)]\n",
        "\n",
        "\n",
        "def mensaje_lote(lote, instruccion):\n",
        "    \"\"\"Mensaje de usuario: cada reseña entre etiquetas con su Id.\n",
        "\n",
        "    lote es un diccionario {Id: texto}. Solo contiene el texto de la\n",
        "    reseña: ni Valoración ni Recomendado_binario llegan nunca al LLM.\n",
        "    \"\"\"\n",
        "    bloques = [f'<resena id=\"{id_}\">\\n{texto}\\n</resena>'\n",
        "               for id_, texto in lote.items()]\n",
        "    return instruccion + '\\n\\n' + '\\n\\n'.join(bloques)"
      ]
