        "def procesar_lote_filtro(lote):\n",
        "    \"\"\"Clasifica un lote {Id: texto} y devuelve {Id: resultado}.\"\"\"\n",
        "    mensajes = [\n",
        "        {'role': 'system', 'content': PROMPT_FILTRO},\n",
        "        {'role': 'user',\n",
        "         'content': mensaje_lote(lote, f'Clasifica estas {len(lote)} '\n",
        "                                       'reseñas:')},\n",
        "    ]\n",
        "\n",
        "    def validar(contenido):\n",
        "        respuesta = RespuestaFiltro.model_validate_json(contenido)\n",
        "        ids = [r.Id for r in respuesta.resultados]\n",
        "        if sorted(ids) != sorted(lote):\n",
        "            raise ValueError(f'Id devueltos {ids} != enviados {list(lote)}')\n",
        "        return {r.Id: r.model_dump() for r in respuesta.resultados}\n",
        "\n",
        "    return llamar_llm(control_filtro, mensajes, ESQUEMA_FILTRO,\n",
