        "MAX_INTENTOS = 3\n",
        "\n",
        "# Registro de tokens estimados vs reales de cada llamada. Se guarda en\n",
        "# disco para conservar el historial aunque se reinicie el notebook.\n",
        "RUTA_REGISTRO = Path('registro_llamadas.json')\n",
        "if RUTA_REGISTRO.exists():\n",
        "    REGISTRO_LLAMADAS = json.loads(RUTA_REGISTRO.read_text(encoding='utf-8'))\n",
        "else:\n",
        "    REGISTRO_LLAMADAS = []\n",
        "\n",
        "\n",
        "def segundos_retry_after(error, por_defecto=10.0):\n",
        "    \"\"\"Lee la cabecera retry-after de un error 429.\"\"\"\n",
        "    try:\n",
        "        return float(error.response.headers.get('retry-after', por_defecto))\n",
        "    except (AttributeError, TypeError, ValueError):\n",
        "        return por_defecto\n",
        "\n",
        "\n",
        "def es_limite_diario(error):\n",
        "    \"\"\"Groq indica en el mensaje del 429 si el límite es diario.\"\"\"\n",
        "    return 'per day' in str(error).lower()\n",
        "\n",
        "\n",
        "def llamar_llm(control, mensajes, esquema, nombre_esquema,\n",
        "               max_tokens_salida, validar):\n",
        "    \"\"\"Llama al modelo con salida estructurada y valida la respuesta.\n",
        "\n",
        "    - Antes de llamar, control.esperar_turno() respeta TPM y RPM.\n",
        "    - Error 429 por minuto: espera lo que indica retry-after y reintenta.\n",
        "    - Error 429 por día: lanza LimiteDiarioAlcanzado (el bucle de lotes\n",
        "      guarda el progreso y se detiene).\n",
        "    - Respuesta cortada o que no supera la validación: se repite.\n",
        "    \"\"\"\n",
        "    tokens_entrada = sum(estimar_tokens(m['content']) for m in mensajes)\n",
        "    ultimo_error = None\n",
        "    for intento in range(1, MAX_INTENTOS + 1):\n",
        "        control.esperar_turno(tokens_entrada + max_tokens_salida)\n",
        "        try:\n",
        "            bruto = cliente.chat.completions.with_raw_response.create(\n",
        "                model=control.modelo,\n",
        "                messages=mensajes,\n",
        "                response_format={\n",
        "                    'type': 'json_schema',\n",
        "                    'json_schema': {'name': nombre_esquema,\n",
        "                                    'strict': True,\n",
        "                                    'schema': esquema},\n",
        "                },\n",
        "                temperature=0,\n",
        "                seed=SEMILLA,\n",
        "                reasoning_effort='low',\n",
        "                max_completion_tokens=max_tokens_salida,\n",
        "            )\n",
        "        except groq.RateLimitError as error:\n",
        "            if es_limite_diario(error):\n",
        "                raise LimiteDiarioAlcanzado(str(error)) from error\n",
        "            espera = segundos_retry_after(error)\n",
        "            print(f'   ⚠️ 429 por límite por minuto: espero {espera:.0f} s '\n",
        "                  f'(intento {intento}/{MAX_INTENTOS})')\n",
        "            time.sleep(espera)\n",
        "            ultimo_error = error\n",
        "            continue\n",
        "        except (groq.APIConnectionError, groq.InternalServerError,\n",
        "                groq.BadRequestError) as error:\n",
        "            # BadRequestError incluye 'json_validate_failed' de Groq\n",
        "            espera = 5 * intento\n",
        "            print(f'   ⚠️ {type(error).__name__}: espero {espera} s '\n",
        "                  f'(intento {intento}/{MAX_INTENTOS})')\n",
        "            time.sleep(espera)\n",
        "            ultimo_error = error\n",
        "            continue\n",
        "\n",
        "        respuesta = bruto.parse()\n",
        "        uso = respuesta.usage\n",
        "        control.registrar(uso.total_tokens, bruto.headers)\n",
        "        REGISTRO_LLAMADAS.append({\n",
        "            'fecha': time.strftime('%Y-%m-%d %H:%M:%S'),\n",
        "            'modelo': control.modelo,\n",
        "            'tokens_entrada_estimados': tokens_entrada,\n",
        "            'tokens_entrada_reales': uso.prompt_tokens,\n",
        "            'tokens_salida_reales': uso.completion_tokens,\n",
        "            'tokens_totales_reales': uso.total_tokens,\n",
        "        })\n",
        "        RUTA_REGISTRO.write_text(json.dumps(REGISTRO_LLAMADAS, indent=1),\n",
        "                                 encoding='utf-8')\n",
        "        eleccion = respuesta.choices[0]\n",
        "        try:\n",
        "            if eleccion.finish_reason == 'length':\n",
        "                raise ValueError('respuesta cortada por max_completion_tokens')\n",
        "            return validar(eleccion.message.content)\n",
        "        except ValueError as error:  # incluye ValidationError de Pydantic\n",
        "            print(f'   ⚠️ Respuesta no válida: {error} '\n",
        "                  f'(intento {intento}/{MAX_INTENTOS})')\n",
        "            ultimo_error = error\n",
        "    raise RuntimeError(f'Sin éxito tras {MAX_INTENTOS} intentos: '\n",
        "                       f'{ultimo_error}')"
      ]
