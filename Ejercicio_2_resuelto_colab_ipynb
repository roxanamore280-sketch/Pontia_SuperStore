        "def presupuesto(lotes, tokens_prompt, tokens_salida, limites):\n",
        "    \"\"\"Estima el gasto de un paso ANTES de llamar a la API.\n",
        "\n",
        "    lotes: lista de lotes (cada lote es una lista de textos).\n",
        "    tokens_prompt: tokens del prompt de sistema (va en cada llamada).\n",
        "    tokens_salida: tokens de respuesta previstos por llamada.\n",
        "    \"\"\"\n",
        "    por_llamada = [tokens_prompt + sum(estimar_tokens(t) for t in lote)\n",
        "                   + tokens_salida for lote in lotes]\n",
        "    total = sum(por_llamada)\n",
        "    return pd.Series({\n",
        "        'Llamadas': len(lotes),\n",
        "        'Tokens de la llamada más grande': max(por_llamada),\n",
        "        'TPM del modelo': limites['tpm'],\n",
        "        'Tokens totales': total,\n",
        "        '% del TPD': round(100 * total / limites['tpd'], 1),\n",
        "        'Minutos mínimos (por TPM)': round(\n",
        "            total / (limites['tpm'] * MARGEN_SEGURIDAD), 1),\n",
        "    })\n",
        "\n",
        "\n",
        "completas = df_unicas['Contenido'].tolist()\n",
        "recortadas = [recortar_inicio_fin(texto, MAX_CARACTERES_FILTRO,\n",
        "                                  CARACTERES_FINAL_FILTRO)\n",
        "              for texto in completas]\n",
        "tokens_completas = [estimar_tokens(texto) for texto in completas]\n",
        "print(f'{len(completas)} reseñas | tokens por reseña completa: '\n",
        "      f'media {np.mean(tokens_completas):.0f}, '\n",
        "      f'máximo {max(tokens_completas)}')\n",
        "print(f'Tokens de todas las reseñas: completas {sum(tokens_completas):,}'\n",
        "      f' | recortadas a {MAX_CARACTERES_FILTRO} caracteres '\n",
        "      f'{sum(estimar_tokens(t) for t in recortadas):,}')\n",
        "\n",
        "lim_filtro = LIMITES[MODELO_FILTRO]\n",
        "lim_extraccion = LIMITES[MODELO_EXTRACCION]\n",
        "escenarios = pd.DataFrame({\n",
        "    'P2 · completas · lote 8': presupuesto(\n",
        "        hacer_lotes(completas, 8), 700, SALIDA_ESTIMADA_FILTRO, lim_filtro),\n",
        "    'P2 · recortadas · lote 8': presupuesto(\n",
        "        hacer_lotes(recortadas, TAM_LOTE_FILTRO), 700,\n",
        "        SALIDA_ESTIMADA_FILTRO, lim_filtro),\n",
        "    'P3 · completas · lote 1': presupuesto(\n",
        "        hacer_lotes(completas, TAM_LOTE_EXTRACCION), 1_000,\n",
        "        SALIDA_ESTIMADA_EXTRACCION, lim_extraccion),\n",
        "    'P3 · completas · lote 3': presupuesto(\n",
        "        hacer_lotes(completas, 3), 1_000, 3 * 400 + 300, lim_extraccion),\n",
        "})\n",
        "escenarios"
