        "class LimiteDiarioAlcanzado(Exception):\n",
        "    \"\"\"Se ha agotado la cuota diaria (RPD o TPD) del modelo.\"\"\"\n",
        "\n",
        "\n",
        "class ControlCuota:\n",
        "    \"\"\"Evita superar los límites por minuto y por día de un modelo.\n",
        "\n",
        "    Guarda los tokens gastados en los últimos 60 segundos (ventana\n",
        "    deslizante). Antes de cada llamada espera con time.sleep() solo lo\n",
        "    necesario para que la nueva petición quepa en el TPM y el RPM.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, modelo, limites, margen=MARGEN_SEGURIDAD):\n",
        "        self.modelo = modelo\n",
        "        self.tpm = limites['tpm'] * margen\n",
        "        self.rpm = limites['rpm'] * margen\n",
        "        self.tpd = limites['tpd']\n",
        "        self.ventana = deque()  # (instante, tokens) de cada llamada\n",
        "        self.tokens_sesion = 0\n",
        "        self.llamadas_sesion = 0\n",
        "        self.esperado_segundos = 0.0\n",
        "        self.peticiones_restantes_hoy = None  # lo informa Groq\n",
        "\n",
        "    def _limpiar_ventana(self):\n",
        "        \"\"\"Olvida las llamadas de hace más de 60 segundos.\"\"\"\n",
        "        ahora = time.time()\n",
        "        while self.ventana and ahora - self.ventana[0][0] >= 60:\n",
        "            self.ventana.popleft()\n",
        "\n",
        "    def esperar_turno(self, tokens_previstos):\n",
        "        \"\"\"Espera hasta que la próxima llamada quepa en el minuto.\"\"\"\n",
        "        if self.peticiones_restantes_hoy == 0:\n",
        "            raise LimiteDiarioAlcanzado(f'{self.modelo}: RPD agotado')\n",
        "        if self.tokens_sesion + tokens_previstos > self.tpd:\n",
        "            raise LimiteDiarioAlcanzado(f'{self.modelo}: se superaría el TPD')\n",
        "        while True:\n",
        "            self._limpiar_ventana()\n",
        "            tokens_minuto = sum(tokens for _, tokens in self.ventana)\n",
        "            cabe = (tokens_minuto + tokens_previstos <= self.tpm\n",
        "                    and len(self.ventana) + 1 <= self.rpm)\n",
        "            if cabe or not self.ventana:\n",
        "                return\n",
        "            espera = 60 - (time.time() - self.ventana[0][0]) + 1\n",
        "            print(f'   ⏳ Pausa de {espera:.0f} s: en el último minuto se '\n",
        "                  f'han gastado {tokens_minuto:,} tokens')\n",
        "            self.esperado_segundos += espera\n",
        "            time.sleep(espera)\n",
        "\n",
        "    def registrar(self, tokens_reales, cabeceras):\n",
        "        \"\"\"Apunta lo que ha gastado realmente una llamada.\"\"\"\n",
        "        self.ventana.append((time.time(), tokens_reales))\n",
        "        self.tokens_sesion += tokens_reales\n",
        "        self.llamadas_sesion += 1\n",
        "        restantes = cabeceras.get('x-ratelimit-remaining-requests')\n",
        "        if restantes is not None:\n",
        "            self.peticiones_restantes_hoy = int(restantes)\n",
        "\n",
        "    def resumen(self):\n",
        "        \"\"\"Texto con el consumo de la sesión.\"\"\"\n",
        "        return (f'{self.modelo}: {self.llamadas_sesion} llamadas, '\n",
        "                f'{self.tokens_sesion:,} tokens '\n",
        "                f'({self.tokens_sesion / self.tpd:.1%} del TPD), '\n",
        "                f'{self.esperado_segundos:.0f} s de pausas. '\n",
        "                f'Peticiones restantes hoy según Groq: '\n",
        "                f'{self.peticiones_restantes_hoy}')"
      ]
