        "def firma_configuracion(*partes):\n",
        "    \"\"\"Identificador corto de modelo + prompt + esquema + recorte.\"\"\"\n",
        "    texto = json.dumps(partes, ensure_ascii=False, sort_keys=True)\n",
        "    return hashlib.sha256(texto.encode('utf-8')).hexdigest()[:12]\n",
        "\n",
        "\n",
        "def cargar_checkpoint(ruta, firma):\n",
        "    \"\"\"Recupera resultados guardados, solo si son de la misma firma.\"\"\"\n",
        "    ruta = Path(ruta)\n",
        "    if not ruta.exists():\n",
        "        return {}\n",
        "    guardado = json.loads(ruta.read_text(encoding='utf-8'))\n",
        "    if guardado.get('firma') != firma:\n",
        "        print('ℹ️ El checkpoint es de otro prompt o modelo: '\n",
        "              'se empieza de cero.')\n",
        "        return {}\n",
        "    return {int(id_): valor for id_, valor in guardado['resultados'].items()}\n",
        "\n",
        "\n",
        "def guardar_checkpoint(ruta, firma, resultados):\n",
        "    \"\"\"Guarda en disco los resultados obtenidos hasta ahora.\"\"\"\n",
        "    contenido = {'firma': firma, 'resultados': resultados}\n",
        "    Path(ruta).write_text(json.dumps(contenido, ensure_ascii=False,\n",
        "                                     indent=1), encoding='utf-8')\n",
        "\n",
        "\n",
        "def ejecutar_por_lotes(textos, tam_lote, procesar_lote, ruta, firma):\n",
        "    \"\"\"Procesa {Id: texto} por lotes guardando el progreso tras cada uno.\n",
        "\n",
        "    Si se alcanza el límite diario, se detiene sin perder lo hecho: al\n",
        "    volver a ejecutar la celda solo se procesan los Id pendientes.\n",
        "    \"\"\"\n",
        "    resultados = cargar_checkpoint(ruta, firma)\n",
        "    pendientes = [id_ for id_ in textos if id_ not in resultados]\n",
        "    lotes = hacer_lotes(pendientes, tam_lote)\n",
        "    print(f'Ya procesadas: {len(textos) - len(pendientes)} | '\n",
        "          f'pendientes: {len(pendientes)} | llamadas previstas: '\n",
        "          f'{len(lotes)}')\n",
        "\n",
        "    for numero, ids in enumerate(lotes, start=1):\n",
        "        lote = {id_: textos[id_] for id_ in ids}\n",
        "        try:\n",
        "            nuevos = procesar_lote(lote)\n",
        "        except LimiteDiarioAlcanzado as error:\n",
        "            print(f'⛔ Límite diario alcanzado: {error}\\n'\n",
        "                  '   El progreso está guardado. Vuelve a ejecutar esta '\n",
        "                  'celda cuando se renueve la cuota (o cambia de modelo).')\n",
        "            break\n",
        "        except RuntimeError as error:\n",
        "            print(f'❌ Lote {numero} sin procesar: {error}')\n",
        "            continue\n",
        "        resultados.update(nuevos)\n",
        "        guardar_checkpoint(ruta, firma, resultados)\n",
        "        print(f'✅ Lote {numero}/{len(lotes)} (Id {ids})')\n",
        "\n",
        "    faltan = [id_ for id_ in textos if id_ not in resultados]\n",
        "    if faltan:\n",
        "        print(f'⚠️ Faltan {len(faltan)} reseñas: {faltan}. '\n",
        "              'Vuelve a ejecutar la celda para completarlas.')\n",
        "    return {id_: resultados[id_] for id_ in textos if id_ in resultados}"
      ]
