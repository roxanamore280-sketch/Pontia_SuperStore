      "source": [
        "y_real = df_resultado['Recomendado_binario'].astype(int)\n",
        "y_pred = df_resultado['Recomendado'].astype(int)\n",
        "df_resultado['Acierto'] = y_real == y_pred\n",
        "\n",
        "accuracy = accuracy_score(y_real, y_pred)\n",
        "linea_base = y_real.value_counts(normalize=True).max()\n",
        "print(f'Accuracy del LLM: {accuracy:.1%} '\n",
        "      f'({df_resultado[\"Acierto\"].sum()} de {len(df_resultado)} aciertos)')\n",
        "print(f'Línea base (predecir siempre la clase mayoritaria): '\n",
        "      f'{linea_base:.1%}')"
