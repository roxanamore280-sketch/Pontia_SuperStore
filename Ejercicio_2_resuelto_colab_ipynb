        "class ClasificacionResena(BaseModel):\n",
        "    \"\"\"Decisión del filtro para una reseña.\"\"\"\n",
        "\n",
        "    model_config = ConfigDict(extra='forbid')  # additionalProperties: false\n",
        "\n",
        "    Id: int\n",
        "    Motivo: Literal['opinion_util', 'spam', 'texto_repetido',\n",
        "                    'sin_sentido', 'broma_o_meme', 'fuera_de_tema']\n",
        "    Relevante: bool\n",
        "\n",
        "    @model_validator(mode='after')\n",
        "    def comprobar_coherencia(self):\n",
        "        \"\"\"Validación extra: Relevante=True solo con 'opinion_util'.\"\"\"\n",
        "        if self.Relevante != (self.Motivo == 'opinion_util'):\n",
        "            raise ValueError(f'Id {self.Id}: Motivo y Relevante no '\n",
        "                             'son coherentes')\n",
        "        return self\n",
        "\n",
        "\n",
        "class RespuestaFiltro(BaseModel):\n",
        "    \"\"\"Respuesta completa del modelo para un lote de reseñas.\"\"\"\n",
        "\n",
